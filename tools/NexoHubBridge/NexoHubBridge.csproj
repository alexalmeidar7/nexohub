<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NexoHubBridge</AssemblyName>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <InformationalVersion>1.2.0</InformationalVersion>
    <ApplicationIcon>assets\NexoHubBridge.ico</ApplicationIcon>
    <RootNamespace>NexoHubBridge</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\bridge-logo.png" LogicalName="NexoHubBridge.assets.bridge-logo.png" />
  </ItemGroup>
  <PropertyGroup>
  </PropertyGroup>
</Project>