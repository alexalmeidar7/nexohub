  # Compatibilidade: URLs antigas do Storage para XML do tempo também devem ler o feed vivo.
  # Arquivos XML estáticos antigos existem em public/storage e não podem vencer esta regra.
  RewriteRule ^storage/v1/object/public/xml-files/xml-tempo-([0-9a-fA-F-]+)\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=$1 [R=302,L,QSA,NE]

  # 2. Existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arquivos de dados/binarios ausentes devem dar 404 real, nunca a SPA.
  # Sem isso, um deploy-info.json fora do docroot parecia "HTTP 200 text/html".
  RewriteRule \.(json|exe|pdb)$ - [R=404,L]

  # 3. Single Page Application (SPA) routing fallback
  RewriteRule ^ index.html [L]
</IfModule>
