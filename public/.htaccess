# NexoHub / Antigravity - Web Server Configuration for Hostinger / LiteSpeed / Apache
# Always serve the latest SPA entry point. Hashed Vite assets remain cacheable,
# but stale index.html can keep some users on an old command picker/catalog.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Set XML MIME type and UTF-8 charset
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "^serve-xml-">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Feeds legados sao encaminhados ao backend ao vivo, preservando user_id,
  # slug e estudio da query. Nunca servir snapshots gerados no build.
  RewriteRule ^functions/v1/serve-xml-(roteiro-estudio|geral|broadcast|logos|enquete|batalha|quiz)/?$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-$1 [R=302,L,QSA,NE]
  RewriteRule ^functions/v1/serve-xml-tempo/?$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo [R=302,L,QSA,NE]

  # URLs legadas por emissora: redirecionamento para dados atuais do banco.
  # XML de tempo e cenários também precisam ser feeds reais, não a SPA.
  RewriteRule ^xml/(positivafm|positiva|p|sub_positiva_opec)/tempo\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=452ebd1e-61a0-42dd-bf80-231a3f426c83 [R=302,L,QSA,NE]
  RewriteRule ^xml/(interativafm|interativa)/tempo\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=9cab6c46-c32a-4c19-94db-773dcfaf7632 [R=302,L,QSA,NE]
  RewriteRule ^xml/(culturafm973|cultura)/tempo\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=b67436c6-ede1-4438-881d-18b9e923adda [R=302,L,QSA,NE]
  RewriteRule ^xml/(transmissao|jornal)/tempo\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=98365ea6-0ebf-496d-83e9-69b38089586d [R=302,L,QSA,NE]
  RewriteRule ^xml/(alex|superadmin)/tempo\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-tempo?user_id=a05c5b71-a100-40f9-8be3-6eb7035a057b [R=302,L,QSA,NE]

  RewriteRule ^xml/(positivafm|positiva|p|sub_positiva_opec)/cenarios-estudio\.xml$ https://qazvgmgdidjhbvcuinpy.supabase.co/functions/v1/serve-xml-cenarios-estudio?uid=452ebd1e-61a0-42dd-bf80-231a3f426c83 [R=302,L,QSA,NE]
