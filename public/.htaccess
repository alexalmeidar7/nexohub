# NexoHub / Antigravity - Web Server Configuration for Hostinger / LiteSpeed / Apache
# Always serve the latest SPA entry point. Hashed Vite assets remain cacheable,
# but stale index.html can keep some users on an old command picker/catalog.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>


<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Set XML MIME type and UTF-8 charset
  <FilesMatch "\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "^serve-xml-">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Feeds legados sao encaminhados ao backend ao vivo, preservando user_id,
  # slug e estudio da query. Nunca servir snapshots gerados no build.
  RewriteRule ^functions/v1/serve-xml-(roteiro-estudio|geral|broadcast|logos|enquete|batalha|quiz)/?$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-$1 [R=302,L,QSA,NE]
  RewriteRule ^functions/v1/serve-xml-tempo/?$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-tempo [R=302,L,QSA,NE]

  # URLs legadas por emissora: redirecionamento para dados atuais do banco.
  RewriteRule ^xml/(positivafm|positiva|p)/roteiro\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-roteiro-estudio?user_id=d17e65af-e407-466f-9b60-b55c43399513\&estudio=FM [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/geral\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-geral?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/broadcast\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-broadcast?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/apenas-xml\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-broadcast?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/logos\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-logos?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/enquete\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-enquete?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/batalha\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-batalha?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
  RewriteRule ^xml/(positivafm|positiva|p)/quiz\.xml$ https://zzjfzxxvxbspbdkodoix.supabase.co/functions/v1/serve-xml-quiz?user_id=d17e65af-e407-466f-9b60-b55c43399513 [R=302,L,QSA,NE]
